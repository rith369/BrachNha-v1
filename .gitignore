# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env — .env.example is committed, real keys are not.
.env
.env.*
!.env.example

# Claude Code local settings — machine-specific paths and permissions.
# .claude/settings.json (shared, if you make one) stays tracked.
.claude/settings.local.json

# Scratch git worktrees Claude Code creates for isolated agent runs. Each one
# is a full checkout of this repo (14MB and counting), and they outlive the run
# that made them — so without this they sit in `git status` forever, one stray
# `git add .` away from committing a copy of the repo into itself.
.claude/worktrees/

# Vercel
.vercel

# Screenshot output from scripts/shots.mjs. Its default --out is ./shots, and a
# run aimed at one feature uses a suffixed dir (shots-lb). Regenerated on demand
# and several MB a run, so it is verification output rather than source.
shots/
shots-*/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
