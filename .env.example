# Copy this file to .env.local and fill in the value.
# .env.local is git-ignored (see .gitignore) — never commit a real key.

# Google Gemini API key, used server-side only by server/chat-handler.ts, which
# Vite serves at POST /api/chat during `npm run dev` (see
# server/vite-chat-plugin.ts). It has no VITE_ prefix on purpose: Vite only
# exposes VITE_-prefixed variables to the browser bundle, so this one stays on
# the server where it belongs.
# Get one free at https://aistudio.google.com/apikey
# Without it the AI Mentor chat degrades to a friendly "unavailable" message
# instead of crashing, so the rest of the app still runs.
GEMINI_API_KEY=
