# Copy this file to .env (or .env.local) and paste your key after the `=`.
# Both are git-ignored — see .gitignore. Never commit a real key.

# Google Gemini API key. Used server-side only:
#   • local dev  — server/chat-handler.ts, served at POST /api/chat by
#                  server/vite-chat-plugin.ts
#   • production — the same handler, via api/chat.ts on Vercel
#
# No VITE_ prefix, on purpose. Vite exposes ONLY VITE_-prefixed variables to the
# browser bundle, so leaving this unprefixed is what keeps the key on the server.
#
# Get one free at https://aistudio.google.com/apikey
# Without it the AI Mentor degrades to a friendly "unavailable" message instead
# of crashing, so the rest of the app still runs.
GEMINI_API_KEY=

# ── Deploying to Vercel ──
# .env files are NOT uploaded. Add GEMINI_API_KEY under
# Project → Settings → Environment Variables, then redeploy.
